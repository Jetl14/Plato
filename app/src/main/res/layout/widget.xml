<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/etiqueta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Te quedan" android:textColor="@color/heroe_gris" android:textSize="12sp"/>
            <TextView android:id="@+id/quedan" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/heroe_tinta" android:textSize="30sp" android:textStyle="bold" android:fontFamily="serif"/>
            <TextView android:id="@+id/detalle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Abre Plato para empezar" android:textColor="@color/heroe_gris" android:textSize="12sp"/>
        </LinearLayout>
        <ImageButton android:id="@+id/btn_foto" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_cam"
            android:background="@drawable/widget_btn" android:contentDescription="Foto" android:layout_marginEnd="8dp"/>
        <ImageButton android:id="@+id/btn_mas" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_plus"
            android:background="@drawable/widget_btn" android:contentDescription="Agregar"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/barra" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent"
        android:layout_height="6dp" android:layout_marginTop="10dp" android:max="100" android:progress="0"
        android:progressTint="#7FD6A6" android:progressBackgroundTint="#55FFFFFF"/>
    <TextView android:id="@+id/macros" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="" android:textColor="@color/heroe_tinta" android:textSize="12sp"/>
</LinearLayout>
